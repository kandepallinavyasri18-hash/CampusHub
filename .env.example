# Copy to .env for local development. Never commit .env or production secrets.
FLASK_ENV=development
PORT=5000

# Generate a private value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-private-random-value-of-at-least-32-characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=campushub_token

# Leave unset to use the local SQLite database at instance/campushub.sqlite.
# For PostgreSQL, use a SQLAlchemy URL such as:
# DATABASE_URL=postgresql+psycopg://username:password@host:5432/campushub

# Keep uploads on a persistent disk in production, e.g. /var/data/uploads on Render.
# Locally the existing server/uploads folder is used by default.
# UPLOADS_PATH=/var/data/uploads
MAX_UPLOAD_BYTES=20971520

# Optional initial values for the secure CLI admin-provisioning command.
ADMIN_NAME=CampusHub Administrator
ADMIN_EMAIL=admin@campushub.local
# ADMIN_PASSWORD must be provided securely or entered at the prompt.
